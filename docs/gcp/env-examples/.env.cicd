# GCP CI/CD Environment Configuration
# Use this configuration for CI/CD pipelines and automated testing

# --------- GCP CI/CD Configuration ------------

# MCP Server Configuration (often not available in CI/CD)
MCP_GCP_ENABLED=false  # Typically disabled in CI/CD environments
GCP_PREFER_MCP=false

# CI/CD Service Account Authentication
# Use CI/CD secrets management for the key
GCP_SERVICE_ACCOUNT_KEY=${GCP_CI_SERVICE_ACCOUNT_KEY}  # From CI/CD secrets
# Alternative: Use key file if mounted as volume
# GCP_SERVICE_ACCOUNT_KEY_PATH=/ci/secrets/gcp-key.json

# CI/CD Project Configuration (from pipeline variables)
GCP_PROJECTS=${DEPLOY_TARGET_PROJECTS}  # e.g., "dev-project,staging-project"
GCP_DEFAULT_PROJECT=${PRIMARY_PROJECT}  # e.g., "dev-project"

# CI/CD Regional Configuration (from pipeline variables)
GCP_REGIONS=${DEPLOY_REGIONS}  # e.g., "us-central1,us-east1"
GCP_ZONES=${DEPLOY_ZONES}      # e.g., "us-central1-a,us-east1-a"

# CI/CD Performance Settings (conservative for stability)
GCP_MAX_WORKERS=5
GCP_REQUEST_TIMEOUT=120  # Longer timeout for CI/CD stability
GCP_RETRY_ATTEMPTS=3

# Service Configuration Based on Pipeline Needs
GCP_ENABLE_BILLING_API=false  # Usually not needed in CI/CD
GCP_ENABLE_COMPUTE_API=true   # For deployment validation
GCP_ENABLE_CONTAINER_API=true # For GKE deployments
GCP_ENABLE_STORAGE_API=true   # For artifact storage
GCP_ENABLE_SQLADMIN_API=false # Usually not needed in CI/CD
GCP_ENABLE_CLOUDFUNCTIONS_API=true  # For serverless deployments
GCP_ENABLE_RUN_API=true       # For Cloud Run deployments

# CI/CD Logging Configuration
LOG_LEVEL=DEBUG  # Detailed logging for troubleshooting
LOG_FORMAT=json  # Structured logging for CI/CD parsing
LOG_TO_STDOUT=true  # Output to stdout for CI/CD capture

# CI/CD Specific Settings
GCP_ENABLE_CACHE=false  # Disable caching for fresh data in CI/CD
GCP_DRY_RUN=${DRY_RUN:-false}  # Allow dry-run mode from pipeline
GCP_VALIDATE_ONLY=true  # Only validate resources, don't modify
GCP_FAIL_FAST=true  # Fail immediately on first error

# CI/CD Environment Detection
CI_ENVIRONMENT=true
PIPELINE_ID=${CI_PIPELINE_ID}
BUILD_NUMBER=${CI_BUILD_NUMBER}
COMMIT_SHA=${CI_COMMIT_SHA}