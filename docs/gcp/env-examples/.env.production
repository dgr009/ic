# GCP Production Environment Configuration
# Copy this file to .env and customize for your production setup

# --------- GCP Production Configuration ------------

# MCP Server Configuration (Highly Recommended for Production)
MCP_GCP_ENABLED=true
MCP_GCP_ENDPOINT=https://mcp-server.company.com/gcp  # Use HTTPS in production
MCP_GCP_AUTH_METHOD=service_account
GCP_PREFER_MCP=true

# Production Service Account Authentication (Fallback)
GCP_SERVICE_ACCOUNT_KEY_PATH=/secure/path/to/prod-service-account.json
# Never use inline keys in production:
# GCP_SERVICE_ACCOUNT_KEY={"type": "service_account", ...}

# Production Multi-Project Configuration
GCP_PROJECTS=prod-project-1,prod-project-2,prod-project-3
GCP_DEFAULT_PROJECT=prod-project-1

# Production Multi-Regional Configuration
GCP_REGIONS=us-central1,us-east1,europe-west1,asia-northeast1
GCP_ZONES=us-central1-a,us-central1-b,us-east1-a,us-east1-b,europe-west1-a,asia-northeast1-a

# Production Performance Settings (optimized for high throughput)
GCP_MAX_WORKERS=20
GCP_REQUEST_TIMEOUT=60  # Longer timeout for production stability
GCP_RETRY_ATTEMPTS=5    # More retries for production reliability

# All Services Enabled in Production
GCP_ENABLE_BILLING_API=true
GCP_ENABLE_COMPUTE_API=true
GCP_ENABLE_CONTAINER_API=true
GCP_ENABLE_STORAGE_API=true
GCP_ENABLE_SQLADMIN_API=true
GCP_ENABLE_CLOUDFUNCTIONS_API=true
GCP_ENABLE_RUN_API=true

# Production Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json  # Structured logging for production
LOG_FILE=/var/log/ic-cli/gcp.log

# Production Security Settings
GCP_ENABLE_CACHE=true
GCP_CACHE_TTL=300  # 5 minutes cache for production efficiency
GCP_SSL_VERIFY=true
GCP_TIMEOUT_MULTIPLIER=1.5  # Extra timeout buffer for production

# Production Monitoring
GCP_ENABLE_METRICS=true
GCP_METRICS_ENDPOINT=https://metrics.company.com/gcp
GCP_HEALTH_CHECK_INTERVAL=60