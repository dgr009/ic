# GCP Development Environment Configuration
# Copy this file to .env and customize for your development setup

# --------- GCP Development Configuration ------------

# MCP Server Configuration (Recommended for Development)
MCP_GCP_ENABLED=true
MCP_GCP_ENDPOINT=http://localhost:8080/gcp
MCP_GCP_AUTH_METHOD=adc  # Use Application Default Credentials for dev
GCP_PREFER_MCP=true

# Fallback Authentication for Development
# Use gcloud auth application-default login to set up ADC
GOOGLE_APPLICATION_CREDENTIALS=~/.config/gcloud/application_default_credentials.json

# Development Project Configuration
GCP_PROJECTS=my-dev-project
GCP_DEFAULT_PROJECT=my-dev-project

# Development Regional Configuration (single region for faster testing)
GCP_REGIONS=us-central1
GCP_ZONES=us-central1-a,us-central1-b

# Development Performance Settings (conservative for local development)
GCP_MAX_WORKERS=5
GCP_REQUEST_TIMEOUT=30
GCP_RETRY_ATTEMPTS=3

# Service Configuration for Development
GCP_ENABLE_BILLING_API=false  # Often not needed in development
GCP_ENABLE_COMPUTE_API=true
GCP_ENABLE_CONTAINER_API=true
GCP_ENABLE_STORAGE_API=true
GCP_ENABLE_SQLADMIN_API=true
GCP_ENABLE_CLOUDFUNCTIONS_API=true
GCP_ENABLE_RUN_API=true

# Development Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=text  # More readable for development

# Development-specific settings
GCP_ENABLE_CACHE=false  # Disable caching for fresh data during development
GCP_DRY_RUN=false  # Set to true to test without making actual API calls