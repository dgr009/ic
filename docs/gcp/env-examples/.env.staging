# GCP Staging Environment Configuration
# Copy this file to .env and customize for your staging setup

# --------- GCP Staging Configuration ------------

# MCP Server Configuration (Recommended for Staging)
MCP_GCP_ENABLED=true
MCP_GCP_ENDPOINT=https://mcp-staging.company.com/gcp
MCP_GCP_AUTH_METHOD=service_account
GCP_PREFER_MCP=true

# Staging Service Account Authentication (Fallback)
GCP_SERVICE_ACCOUNT_KEY_PATH=/secure/path/to/staging-service-account.json

# Staging Project Configuration
GCP_PROJECTS=staging-project-1,staging-project-2
GCP_DEFAULT_PROJECT=staging-project-1

# Staging Regional Configuration (subset of production regions)
GCP_REGIONS=us-central1,us-east1
GCP_ZONES=us-central1-a,us-central1-b,us-east1-a

# Staging Performance Settings (balanced for testing)
GCP_MAX_WORKERS=10
GCP_REQUEST_TIMEOUT=45
GCP_RETRY_ATTEMPTS=4

# Service Configuration for Staging
GCP_ENABLE_BILLING_API=true   # Test billing integration
GCP_ENABLE_COMPUTE_API=true
GCP_ENABLE_CONTAINER_API=true
GCP_ENABLE_STORAGE_API=true
GCP_ENABLE_SQLADMIN_API=true
GCP_ENABLE_CLOUDFUNCTIONS_API=true
GCP_ENABLE_RUN_API=true

# Staging Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/ic-cli/staging-gcp.log

# Staging-specific Settings
GCP_ENABLE_CACHE=true
GCP_CACHE_TTL=180  # 3 minutes cache for staging
GCP_ENABLE_DEBUG_MODE=true  # Additional debugging for staging
GCP_VALIDATE_RESOURCES=true  # Extra validation in staging