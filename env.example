# -------  COMMON ENV ----------
LOG_LEVEL=DEBUG  # Log level setting
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/0000000000000000/0000000000000000/0000000000000000

# --------- AWS ENV ------------
REGIONS=ap-northeast-1         # aws regions. ex) ap-northeast-1,ap-northeast-2
AWS_ACCOUNTS=222222222222         # aws Account. ex) 222222222222, 22222222222

# --------- TAG ENV ------------
REQUIRED_TAGS=User,CreateBy,Team,TeamName,Name,Service,Application,Role,Environment
OPTIONAL_TAGS=Env
RULE_USER=^.+$
RULE_TEAM=^\d+$
RULE_NAME=^[a-zA-Z0-9_.\-/+() ]+$
RULE_ROLE=^[a-zA-Z0-9_\-+, ]+$
RULE_ENVIRONMENT=^(PROD|STG|DEV|TEST|QA)$

# --------- CloudFlare ------------
CLOUDFLARE_EMAIL=aaa@gmail.com     # Account Login Email
CLOUDFLARE_API_TOKEN=tokentokentoken        # Account Token(Account Level)
CLOUDFLARE_ACCOUNTS=aaa,bbb       # Account (NAME)
CLOUDFLARE_ZONES=aaa,bbb             # HOSTZONE (NAME)

# --------- OCI ------------
OCI_CONFIG_PATH=~/.oci/config               # OCI config 파일 경로
SHOW_EMPTY_COMPARTMENTS=false               # 빈 컴파트먼트 표시 여부

# --------- SSH ------------
SSH_KEY_DIR=~/aws-key               # 기본 키파일 디렉토리
SSH_CONFIG_FILE=~/.ssh/config       # ~/.ssh/config 경로 (커스텀일 수 있음)
SSH_MAX_WORKER=70                   # 병렬 스캔 스레드 수
PORT_OPEN_TIMEOUT=0.5               # 포트스캔 timeout
SSH_TIMEOUT=5                       # SSH 접속 timeout
SSH_SKIP_PREFIXES=git,akrr,gw,lab   # SSH 스캔 스킵 할 HostName Prefix(쉼표로 구분)

# --------- Azure ------------
# Azure 인증 정보 (Service Principal 사용 시)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Azure 구독 및 위치 설정
AZURE_SUBSCRIPTIONS=subscription-id-1,subscription-id-2
AZURE_LOCATIONS=East US,West US 2,Korea Central,Southeast Asia

# --------- GCP ------------
# GCP Authentication (choose one method)
# Method 1: Service Account Key Path
GCP_SERVICE_ACCOUNT_KEY_PATH=/path/to/service-account.json
# Method 2: Service Account Key JSON (inline)
# GCP_SERVICE_ACCOUNT_KEY={"type": "service_account", "project_id": "your-project", ...}
# Method 3: Application Default Credentials path
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# GCP Project Configuration
GCP_PROJECTS=project-1,project-2,project-3
GCP_DEFAULT_PROJECT=my-default-project

# GCP Regional Configuration
GCP_REGIONS=us-central1,us-east1,europe-west1
GCP_ZONES=us-central1-a,us-central1-b,europe-west1-a

# GCP Performance Tuning
GCP_MAX_WORKERS=10
GCP_REQUEST_TIMEOUT=30
GCP_RETRY_ATTEMPTS=3
